# SimuCell3D Static Analysis Configuration
#
# Usage:
#   clang-tidy -p build <file>                    # Run on single file
#   run-clang-tidy -p build src/                  # Run on all source files
#
# Requires compile_commands.json (generated by CMAKE_EXPORT_COMPILE_COMMANDS)

---
# Conservative check set - catches real bugs without excessive noise
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  clang-analyzer-*,
  performance-*,
  -performance-unnecessary-value-param,
  modernize-use-nullptr,
  modernize-use-override,
  readability-redundant-string-cstr,
  readability-misleading-indentation,
  readability-braces-around-statements,
  misc-unused-parameters

# Don't treat warnings as errors - advisory only
WarningsAsErrors: ''

# Only analyze project headers, not system/library headers
HeaderFilterRegex: 'include/.*\.hpp$'

# Check system headers (disabled - too noisy)
CheckOptions:
  - key: bugprone-assert-side-effect.AssertMacros
    value: 'assert'
  - key: bugprone-sizeof-expression.WarnOnSizeOfConstant
    value: 'true'
  - key: bugprone-sizeof-expression.WarnOnSizeOfIntegerExpression
    value: 'true'
  - key: modernize-use-nullptr.NullMacros
    value: 'NULL'
  - key: readability-braces-around-statements.ShortStatementLines
    value: '1'
  - key: misc-unused-parameters.StrictMode
    value: 'false'

# Format of diagnostics
FormatStyle: 'file'
---
